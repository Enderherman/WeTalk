# Copy to .env on the NAS; do not commit .env.
DB_URL=jdbc:mysql://mysql-host:3306/easychat?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=wetalk
DB_PASSWORD=replace-with-database-password
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-redis-password
REDIS_SSL=false
ADMIN_EMAILS=
HTTP_PUBLISHED_PORT=5050
WS_PUBLISHED_PORT=5051
WETALK_DATA_DIR=./data
WETALK_AI_ENABLED=false
WETALK_AI_MODEL=none
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=deepseek-chat
OPENAI_API_KEY=
